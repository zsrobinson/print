# Load through your process manager; nothing reads a .env file automatically.
ACCESS_ISSUER=https://example.cloudflareaccess.com
ACCESS_AUD=replace-with-application-audience
PUBLIC_ORIGIN=https://print.example.com
# JSON array of { name, url, icon?, colour? } kept outside this repository.
SERVICE_MANIFEST=/etc/print-web/services.json
# Loopback only; the token is sent to nothing else.
PRINT_CORE_URL=http://127.0.0.1:8765
PRINT_CORE_TOKEN=replace-with-core-token
# Optional: a separate scrape credential for /metrics.
# METRICS_TOKEN=replace-with-metrics-token
PORT=8787
BIND_ADDRESS=127.0.0.1
