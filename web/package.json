{
  "name": "print-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "tsx server.ts",
    "fixtures": "tsx scripts/fixture-core.ts",
    "capture": "tsx scripts/capture.ts",
    "shell:update": "node scripts/shell-update.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@zsrobinson/shell": "git+https://github.com/zsrobinson/shell.git#e682407c9a0ba86eb9d6aeb64f7d6163a33ec792",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.8.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.2.0"
  }
}
